(defwidget appmenu []
  (box
    :class "appmenu"
    :orientation "h"
    :halign "start"
    (button
      :onclick "scripts/open.sh --powermenu"
      "󰣇"
    )
  )
)

(defwidget workspaces []
  (box
    :class "workspaces"
    :orientation "h"
    :space-evenly false
    :hexpand true
    (for entry in workspaces_arr
      (button
        :hexpand true
        :tooltip "Workspace ${entry.id}"
        :onclick "hyprctl dispatch workspace ${entry.id}"
        :class "${entry.active == 1 ? 'active' : ''}"
        {entry.icon}
      )
    )
  )
)

(defwidget clock []
  (eventbox
    :onclick "scripts/open.sh --calendar"
    :class "clock"
    (box
      :class "content"
      :orientation "h"
      :space-evenly false
      :hexpand true
      (label :text "" :class "icon")
      (label :text time_text :class "text")
    )
  )
)

(defwidget volume []
  (box
    :class "volume"
    :orientation "h"
    :space-evenly false
    :hexpand true
    (button
      :hexpand true
      :onclick "scripts/open.sh --audio"
      {vol_icon}
    )
  )
)

(defwidget backlight []
  (box
    :class "backlight"
    :orientation "h"
    :space-evenly false
    :hexpand true
    (button
      :hexpand true
      :onclick "scripts/open.sh --backlight"
      {back_icon}
    )
  )
)

(defwidget battery []
  (eventbox
    :onclick "scripts/open.sh --battery"
    :class "battery"
    (box
      :class "content"
      :orientation "h"
      :space-evenly false
      :hexpand true
      (label :text {bat_icon} :class "icon")
      (label :text "${bat_cap}%" :class "text")
    )
  )
)

(defwidget network []
  (eventbox
    :onclick "scripts/open.sh --network"
    :class "network"
    (box
      :class "content"
      :orientation "h"
      :space-evenly false
      :hexpand true
      (label :text {net_icon} :class "icon")
      ; (box
        ;   :class "net_speed"
        ;   :halign "end"
        ;   :width 85
        ;   :hexpand true
        ;   (label :halign "end" :text "${net_rx_rate} ${net_rx_unit}" :class "text")
      ; )
    )
  )
)

(defwidget tray []
  (box
    :class "tray"
    :orientation "h"
    :hexpand true
    :vexpand true
    :space-evenly false
    
    (box
      :class "tray_wrapper"
      (revealer
        :reveal {systray_open}
        :transition "slideleft"
        :duration "300ms"
        (systray
          :class "system_tray"
          :spacing 10
          :orientation "h"
          :space-evenly false
          :icon-size 16
          :prepend-new true
        )
      )
    )
    
    (button
      :tooltip "Toggle system tray"
      :hexpand false
      :class "revealer"
      :onclick "eww update systray_open=${!systray_open}"
      {systray_open ? "" : ""}
    )
  )
)

(defwidget widgets_left []
  (box
    :class "widgets_left"
    :orientation "h"
    :space-evenly false
    :spacing 5
    :halign "start"
    :hexpand true
    (appmenu)
  )
)

(defwidget widgets_middle []
  (box
    :class "widgets_middle"
    :orientation "h"
    :space-evenly false
    :spacing 5
    :halign "center"
    :hexpand true
    (workspaces)
  )
)

(defwidget widgets_right []
  (box
    :class "widgets_right"
    :orientation "h"
    :space-evenly false
    :spacing 5
    :halign "end"
    :hexpand true
    (tray)
    (volume)
    (backlight)
    (network)
    (battery)
    (clock)
  )
)

(defwidget bar_I []
  (box
    :class "taskbar"
    :orientation "h"
    :hexpand true
    (widgets_left)
    (widgets_middle)
    (widgets_right)
  )
)

(defwindow statusbar
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "5px"
    :width "100%"
    :height "34px"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive true
  (bar_I)
)