! X colors.
! Generated by 'wal'
*foreground:        #ecc2c8
*background:        #0E1431
*.foreground:       #ecc2c8
*.background:       #0E1431
emacs*foreground:   #ecc2c8
emacs*background:   #0E1431
URxvt*foreground:   #ecc2c8
XTerm*foreground:   #ecc2c8
UXTerm*foreground:  #ecc2c8
URxvt*background:   [100]#0E1431
XTerm*background:   #0E1431
UXTerm*background:  #0E1431
URxvt*cursorColor:  #ecc2c8
XTerm*cursorColor:  #ecc2c8
UXTerm*cursorColor: #ecc2c8
URxvt*borderColor:  [100]#0E1431

! Colors 0-15.
*.color0: #0E1431
*color0:  #0E1431
*.color1: #C54764
*color1:  #C54764
*.color2: #EF9872
*color2:  #EF9872
*.color3: #1C658D
*color3:  #1C658D
*.color4: #574F87
*color4:  #574F87
*.color5: #B36E8F
*color5:  #B36E8F
*.color6: #2BA6C5
*color6:  #2BA6C5
*.color7: #ecc2c8
*color7:  #ecc2c8
*.color8: #a5878c
*color8:  #a5878c
*.color9: #C54764
*color9:  #C54764
*.color10: #EF9872
*color10:  #EF9872
*.color11: #1C658D
*color11:  #1C658D
*.color12: #574F87
*color12:  #574F87
*.color13: #B36E8F
*color13:  #B36E8F
*.color14: #2BA6C5
*color14:  #2BA6C5
*.color15: #ecc2c8
*color15:  #ecc2c8

! Black color that will not be affected by bold highlighting.
*.color66: #0E1431
*color66:  #0E1431

! Xclock colors.
XClock*foreground: #ecc2c8
XClock*background: #0E1431
XClock*majorColor:  rgba:ec/c2/c8/ff
XClock*minorColor:  rgba:ec/c2/c8/ff
XClock*hourColor:   rgba:ec/c2/c8/ff
XClock*minuteColor: rgba:ec/c2/c8/ff
XClock*secondColor: rgba:ec/c2/c8/ff

! Set depth to make transparency work.
URxvt*depth: 32
