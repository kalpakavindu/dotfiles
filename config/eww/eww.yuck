; Written by KalpaKavindu <kalpadevonline@gmail.com>

; Variables
(defvar systray_open true) ; This is my prefference. Set default to false.
(defvar vol_lev "0")
(defvar vol_muted "false")
(defvar vol_dev "Sound Output")

(defvar mic_lev "0")
(defvar mic_muted "false")
(defvar mic_dev "Sound Input")
(defvar sound_server "Disabled")

(defvar back_lev "0")
(defvar eye_comf_on "false")
(defvar back_dev "Brightness")

(defvar bat_chr "0")
(defvar bat_chr_def "0")
(defvar bat_cap "0")
(defvar pow_mod "2")

(defvar net_ifname "")
(defvar net_wifi_active false)
(defvar net_hotspot_active false)
(defvar net_aeroplane_active false)
(defvar net_wifi "{}")
(defvar net_enp_list "[]")

(defvar not_count "0")

; Listners
(deflisten workspaces_arr :initial "[]" "scripts/workspaces.sh")
(deflisten back_icon :initial "󰛩" "scripts/backlight.sh --listen-brightness")
(deflisten vol_icon :initial "" "scripts/volume.sh --listen-volume")
(deflisten mic_icon :initial "" "scripts/volume.sh --listen-mic")
(deflisten net_icon :initial "" "scripts/network.sh --listen-icon")
(deflisten not_icon :initial "󰂚" "scripts/swaync.sh --listen")

; Dynamic
(defpoll bat_icon :interval "2s" "scripts/battery.sh --icon")
(defpoll time_text :interval "5s" "date '+%H:%M'")
(defpoll calendar_day :interval "20h" "date '+%d'")
(defpoll calendar_year :interval "20h" "date '+%Y'")

; -------- Custom Widgets --------
(defwidget _seperator [hide]
  (revealer
    :transition "slidedown"
    :reveal "${!hide}"
    :duration "300ms"
    (box
      :class "seperator"
      :orientation "h"
      :valign "center"
      :hexpand true
      :vexpand false
      :space-evenly false
      
      (box
        :class "line"
        :space-evenly false
        :hexpand true
        :vexpand false
        :valign "center"
      )
    )
  )
)

(defwidget _tile [icon tooltip command active timeout]
  (button
    :class "tile ${active ? 'active' : ''}"
    :tooltip "${tooltip}"
    :hexpand true
    :onclick "${command}"
    :timeout "${timeout}"
    "${icon}"
  )
)

(defwidget _bar_control [class icon device onprochange onbtnclick active level]
  (box
    :class "bar_control ${class}"
    :halign "center"
    :space-evenly false
    :hexpand false
    :vexpand false
    (button
      :class "control_icon ${active == 'true' ? 'active' : ''}"
      :onclick {onbtnclick}
      {icon}
    )
    (box
      :orientation "v"
      :halign "center"
      :vexpand false
      :hexpand true
      (label :class "control_text" :limit-width 24 :halign "start" :tooltip "${device}" :text "${device}")
      (box
        :class "control_bar"
        :halign "start"
        :vexpand false
        :hexpand false
        (scale
          :value level
          :orientation "h"
          :onchange {onprochange}
          :max 101
          :min 0
        )
      )
    )
    (box
      :orientation "h"
      :vexpand false
      :hexpand true
      :halign "end"
      :class "control_level"
      :width 40
      (label :text "${level}%")
    )
  )
)

(defwidget _pmenu_item [onclick label icon]
  (eventbox
    :class "menu_item"
    :onclick {onclick}
    (box
      :class "wrapper"
      :orientation "h"
      :hexpand true
      :vexpand false
      :halign "start"
      :valign "center"
      :space-evenly false
      :spacing 10
      (label  :text {icon} :class "icon" :hexpand true)
      (label :text {label} :class "text" :hexpand true)
    )
  )
)
; -------- Custom Widgets --------


(include "./statusbar.yuck")

; -------- Power Menu --------
(defwidget pmenu []
  (box
    :orientation "v"
    :space-evenly false
    :vexpand true
    :hexpand true
    :class "pmenu"
    
    (_pmenu_item :onclick "" :label "Lock Screen" :icon "󰌾")
    (_pmenu_item :onclick "uwsm stop" :label "Logout" :icon "󰍃")
    
    (_seperator :hide false)
    
    (_pmenu_item :onclick "systemctl suspend" :label "Suspend" :icon "󰒲")
    (_pmenu_item :onclick "systemctl reboot" :label "Restart" :icon "󰜉")
    (_pmenu_item :onclick "systemctl hibernate" :label "Hibernate" :icon "󰤁")
    (_pmenu_item :onclick "systemctl poweroff" :label "Shutdown" :icon "󰐥")
    
  )
)

(defwindow powermenu_popup
  :monitor 0
  :geometry (geometry
    :x "5px"
    :y "5px"
    :anchor "top left"
    :width "150px"
    :height "50px"
  )
  :namespace "eww_popup"
  (pmenu)
)
; -------- Power Menu --------

; -------- Calendar --------
(defwidget cal []
  (box
    :class "calendar_wrapper"
    :orientation "h"
    (calendar
      :day calendar_day
      :year calendar_year
    )
  )
)

(defwindow calendar_popup
  :monitor 0
  :geometry (geometry
    :x "5px"
    :y "5px"
    :anchor "top right"
    :width "270px"
    :height "60px"
  )
  :namespace "eww_popup"
  (cal)
)
; -------- Calendar --------

; -------- Audio Popup --------
(defwidget audio_control []
  (box
    :class "audio_control"
    :orientation "v"
    :space-evenly false
    :vexpand false
    :hexpand true
    
    (_bar_control
      :class "vol"
      :active "${vol_muted == 'true'}"
      :onbtnclick "scripts/volume.sh --toggle-volume"
      :onprochange "scripts/volume.sh --set-volume {}"
      :device {vol_dev}
      :level {vol_lev}
      :icon {vol_icon}
    )
    
    (_seperator :hide false)
    
    (_bar_control
      :class "mic"
      :active "${mic_muted == 'true'}"
      :onbtnclick "scripts/volume.sh --toggle-mic"
      :onprochange "scripts/volume.sh --set-mic {}"
      :device {mic_dev}
      :level {mic_lev}
      :icon {mic_icon}
    )
    
    (box
      :class "footer"
      :orientation "h"
      :hexpand true
      :space-evenly false
      
      (box
        :orientation "h"
        :space-evenly false
        :halign "start"
        :hexpand true
        (label :class "a_control_text" :limit-width 32 :halign "start" :text {sound_server})
      )
      
      (box
        :orientation "h"
        :space-evenly false
        :halign "end"
        :hexpand true
        (button
          :class "settings_btn"
          :onclick "pavucontrol &"
          ""
        )
      )
    )
  )
)

(defwindow audio_popup
  :monitor 0
  :geometry (geometry
    :x "180px"
    :y "5px"
    :anchor "top right"
    :width "280px"
    :height "60px"
  )
  :namespace "eww_popup"
  (audio_control)
)
; -------- Audio Popup --------


; -------- Backlight Popup --------
(defwidget backlight_control []
  (box
    :class "backlight_control"
    :orientation "v"
    :space-evenly false
    :vexpand false
    :hexpand true
    
    (_bar_control
      :class "back"
      :active "${eye_comf_on == 'true'}"
      :onbtnclick "scripts/backlight.sh --toggle-eye"
      :onprochange "scripts/backlight.sh --set {}"
      :device {back_dev}
      :level {back_lev}
      :icon "󰈈"
    )
  )
)

(defwindow backlight_popup
  :monitor 0
  :geometry (geometry
    :x "150px"
    :y "5px"
    :anchor "top right"
    :width "280px"
    :height "30px"
  )
  :namespace "eww_popup"
  (backlight_control)
)
; -------- Backlight Popup --------


; -------- Battery Popup --------
(defwidget battery_control []
  (box
    :class "battery_control"
    :orientation "v"
    :space-evenly false
    :vexpand false
    :hexpand true
    (box
      :class "profile_text"
      :orientation "h"
      :space-evenly false
      :vexpand true
      :hexpand true
      (label :class "title" :text "Mode:")
      (label :class "text" :text {pow_mod == "0" ? "Best battery" : pow_mod == "1" ? "Balanced" : "Best performance"})
    )
    (box
      :class "profile_control"
      :orientation "h"
      :space-evenly false
      :spacing 5
      :vexpand true
      :hexpand true
      (_tile
        :command "eww update pow_mod=0"
        :active "${pow_mod == 0}"
        :tooltip "Best battery"
        :icon "󰩆"
        :timeout "200ms"
      )
      (_tile
        :command "eww update pow_mod=1"
        :active "${pow_mod == 1}"
        :tooltip "Balanced"
        :icon "󰇻"
        :timeout "200ms"
      )
      (_tile
        :command "eww update pow_mod=2"
        :active "${pow_mod == 2}"
        :tooltip "Best performance"
        :icon "󰇺"
        :timeout "200ms"
      )
    )
    (box
      :class "footer"
      :orientation "h"
      :space-evenly false
      :vexpand true
      :hexpand true
      (box
        :class "charge"
        :orientation "h"
        :space-evenly false
        :hexpand true
        :vexpand false
        :halign "start"
        (label :text "󰉁" :class "icon")
        (label :text "${bat_chr}%")
        (label :text "" :class "sep")
        (label :text "(${bat_chr_def}mAh)")
      )
      
      (box
        :orientation "h"
        :space-evenly false
        :halign "end"
        :hexpand true
        (button
          :class "settings_btn"
          :onclick "pavucontrol &"
          ""
        )
      )
    )
  )
)

(defwindow battery_popup
  :monitor 0
  :geometry (geometry
    :x "20px"
    :y "5px"
    :anchor "top right"
    :width "280px"
    :height "30px"
  )
  :namespace "eww_popup"
  (battery_control)
)
; -------- Battery Popup --------

; -------- Network Popup --------
(defwidget network_control []
  (box
    :class "network_control"
    :orientation "v"
    :space-evenly false
    :hexpand true
    :vexpand false
    
    (revealer
      :reveal "${net_enp_list != '[]'}"
      :transition "slidedown"
      :duration "300ms"
      (box
        :class "enp_data"
        :orientation "v"
        :spacing 5
        :space-evenly false
        :vexpand true
        
        (for entry in net_enp_list
          (eventbox
            :class "enp_item ${entry.inuse == 1 ? 'active' : ''}"
            :onclick ""
            :hexpand true
            (box
              :class "enp_item_content"
              :valign "center"
              :orientation "h"
              :hexpand true
              :space-evenly false
              
              (box
                :class "icon"
                :orientation "h"
                :hexpand false
                :space-evenly false
                :height 40
                (label :text "󱂇")
              )
              
              (box
                :class "data_box"
                :orientation "v"
                :height 40
                :width 200
                :space-evenly false
                :tooltip "${entry.cname}"
                :hexpand false
                :halign "start"
                
                (label
                  :class "enp_cname"
                  :text "${entry.cname}"
                  :show-truncated true
                  :limit-width 25
                  :halign "start"
                )
                
                (label :class "enp_ifname" :text "${entry.ifname}" :halign "start")
              )
            )
          )
        )
      )
    )
    
    (_seperator :hide "${arraylength(net_enp_list) == 0}")
    
    (box
      :class "wifi_data"
      :orientation "v"
      :space-evenly false
      :hexpand true
      
      (box
        :class "title"
        :orientation "h"
        :space-evenly false
        :hexpand true
        :vexpand false
        (label :halign "start" :hexpand true :text "Wi-Fi ${net_wifi_active?'turned on':'turned off'}")
      )
      
      (revealer
        :reveal "${net_wifi_active}"
        :transition "slidedown"
        :duration "300ms"
        
        (overlay
          :vexpand false
          :hexpand true
          :height 60
          
          (revealer
            :reveal "${net_wifi == '{}'}"
            :transition "crossfade"
            :duration "300ms"
            :vexpand true
            :hexpand true
            (box
              :class "wifi_empty"
              :orientation "v"
              :space-evenly false
              :height 60
              (label :hexpand true :vexpand true :text "No device connected")
            )
          )
          
          (revealer
            :vexpand true
            :hexpand true
            :reveal "${net_wifi != '{}'}"
            :transition "crossfade"
            :duration "300ms"
            
            (eventbox
              :class "wifi_item active"
              :hexpand true
              :vexpand false
              :onclick ""
              (box
                :class "wifi_item_content"
                :valign "center"
                :orientation "h"
                :space-evenly false
                :height 50
                :vexpand false
                :hexpand true
                
                (box
                  :class "icon"
                  :orientation "h"
                  :hexpand false
                  :space-evenly false
                  :height 40
                  (label :text "${net_wifi.icon}")
                )
                
                (box
                  :class "data_box"
                  :orientation "v"
                  :hexpand true
                  :vexpand false
                  :height 40
                  :width 200
                  :space-evenly false
                  :tooltip "${net_wifi.ssid}"
                  
                  (label
                    :class "wifi_cname"
                    :text "${net_wifi.ssid}"
                    :show-truncated true
                    :limit-width 20
                    :halign "start"
                  )
                  
                  (label :class "wifi_mac" :text "${net_wifi.bssid}" :halign "start")
                )
              )
            )
          )
        )
      )
    )
    
    (_seperator :hide false)
    
    (box
      :class "shortcuts"
      :orientation "h"
      :space-evenly true
      :spacing 5
      (_tile
        :command "scripts/network.sh --toggle-wifi"
        :active "${net_wifi_active == true}"
        :tooltip "Wi-Fi"
        :icon "󱚻"
        :timeout "8s"
      )
      (_tile
        :command "eww update net_hotspot_active=${!net_hotspot_active}"
        :active "${net_hotspot_active == true}"
        :tooltip "Hotspot"
        :icon "󰑩"
        :timeout "200ms"
      )
      (_tile
        :command "eww update net_aeroplane_active=${!net_aeroplane_active}"
        :active "${net_aeroplane_active == true}"
        :tooltip "Aeroplane Mode"
        :icon "󰀝"
        :timeout "200ms"
      )
    )
    
    (box
      :class "footer"
      :orientation "h"
      :space-evenly false
      :vexpand true
      :hexpand true
      (box
        :class "details"
        :orientation "h"
        :space-evenly false
        :hexpand true
        :vexpand false
        :halign "start"
        (box
          :class "net_data"
          :orientation "h"
          :space-evenly false
          :hexpand false
          :width 110
          (label :text "" :class "icon")
          (label :text "${net_ifname == '' ? 'Disconnected' : net_ifname}")
        )
        ; (label :class "sep")
        ; (box
          ;   :class "net_data"
          ;   :orientation "h"
          ;   :space-evenly false
          ;   :hexpand false
          ;   :width 110
          ;   (label :text "󰶡" :class "icon")
          ;   (label :text "${net_rx_rate} ${net_rx_unit}")
        ; )
      )
      
      (box
        :orientation "h"
        :space-evenly false
        :halign "end"
        :hexpand true
        (button
          :class "settings_btn"
          :onclick ""
          ""
        )
      )
    )
  )
)

(defwindow network_popup
  :monitor 0
  :geometry (geometry
    :x "100px"
    :y "5px"
    :anchor "top right"
    :width "300px"
    :height "190px"
  )
  :namespace "eww_popup"
  (network_control)
)
; -------- Network Popup --------

; -------- Volume Notifier --------
(defwidget volume_notifier_data []
  (box
    :orientation "h"
    :space-evenly false
    :hexpand false
    :class "notifier"
    
    (label :halign "start" :hexpand true :text {vol_icon} :class "icon")
    
    (progress
      :width 70
      :halign "start"
      :valign "center"
      :hexpand true
      :vexpand false
      :flipped false
      :value {vol_lev}
      :orientation "h"
    )
    
    (label :halign "end" :hexpand true :text "${vol_lev}%" :class "text")
  )
)
(defwindow volume_notifier
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "5px"
    :anchor "bottom center"
    :width "200px"
    :height "50px"
  )
  :stacking "overlay"
  :namespace "eww_popup"
  (volume_notifier_data)
)
; -------- Volume Notifier --------

; -------- Brightness Notifier --------
(defwidget brightness_notifier_data []
  (box
    :orientation "h"
    :space-evenly false
    :hexpand false
    :class "notifier"
    
    (label :halign "start" :hexpand true :text {back_icon} :class "icon")
    
    (progress
      :width 70
      :halign "start"
      :valign "center"
      :hexpand true
      :vexpand false
      :flipped false
      :value {back_lev}
      :orientation "h"
    )
    
    (label :halign "end" :hexpand true :text "${back_lev}%" :class "text")
  )
)
(defwindow brightness_notifier
  :monitor 0
  :geometry (geometry
    :x "0%"
    :y "5px"
    :anchor "bottom center"
    :width "200px"
    :height "50px"
  )
  :stacking "overlay"
  :namespace "eww_popup"
  (brightness_notifier_data)
)
; -------- Brightness Notifier --------